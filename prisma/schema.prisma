// ═══════════════════════════════════════════════════════════════════════
// FM-PREMED — Schema Prisma (HL7 FHIR)
// Sistema de Fichas Médicas para Clínica Interna de Empresa
// ═══════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "mysql"
}

// ═══════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════

enum UserRole {
  ADMIN
  DOCTOR
  VIEWER
}

enum Sex {
  MALE
  FEMALE
}

enum DocumentType {
  DPI
  PASSPORT
  OTHER
}

enum PregnancyStatus {
  PREGNANT
  POSTPARTUM
  NOT_PREGNANT
  NOT_APPLICABLE
}

enum BmiCategory {
  UNDERWEIGHT
  NORMAL
  OVERWEIGHT
  OBESE_I
  OBESE_II
  OBESE_III
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
}

// ═══════════════════════════════════════════════════════════════════════
// AUTENTICACIÓN — better-auth
// ═══════════════════════════════════════════════════════════════════════

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?  @db.Text
  role          UserRole @default(VIEWER)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones better-auth
  sessions Session[]
  accounts Account[]

  // Vínculo a Person (Opcional para que Better Auth no falle al crear)
  personId Int?    @unique
  person   Person? @relation(fields: [personId], references: [id])

  // Relaciones del negocio
  encounters Encounter[]
  documents  Document[]
  auditLogs  AuditLog[]

  banned     Boolean?  @default(false)
  banReason  String?   @db.Text
  banExpires DateTime?

  preamble String? @db.Text

  // Relaciones de auditoría (creación/modificación)
  createdPersons      Person[]      @relation("CreatedPerson")
  updatedPersons      Person[]      @relation("UpdatedPerson")
  createdPatients     Patient[]     @relation("CreatedPatient")
  updatedPatients     Patient[]     @relation("UpdatedPatient")
  createdEncounters   Encounter[]   @relation("CreatedEncounter")
  updatedEncounters   Encounter[]   @relation("UpdatedEncounter")
  createdCompanies    Company[]     @relation("CreatedCompany")
  updatedCompanies    Company[]     @relation("UpdatedCompany")
  createdWorkplaces   Workplace[]   @relation("CreatedWorkplace")
  updatedWorkplaces   Workplace[]   @relation("UpdatedWorkplace")
  createdWorkAreas    WorkArea[]    @relation("CreatedWorkArea")
  updatedWorkAreas    WorkArea[]    @relation("UpdatedWorkArea")
  createdJobPositions JobPosition[] @relation("CreatedJobPosition")
  updatedJobPositions JobPosition[] @relation("UpdatedJobPosition")

  createdEncounterTypes            EncounterType[]            @relation("CreatedEncounterType")
  updatedEncounterTypes            EncounterType[]            @relation("UpdatedEncounterType")
  createdOccupationalExposures     OccupationalExposure[]     @relation("CreatedOccupationalExposure")
  updatedOccupationalExposures     OccupationalExposure[]     @relation("UpdatedOccupationalExposure")
  createdWorkDisabilitys           WorkDisability[]           @relation("CreatedWorkDisability")
  updatedWorkDisabilitys           WorkDisability[]           @relation("UpdatedWorkDisability")
  createdSurgicalProcedureCatalogs SurgicalProcedureCatalog[] @relation("CreatedSurgicalProcedureCatalog")
  updatedSurgicalProcedureCatalogs SurgicalProcedureCatalog[] @relation("UpdatedSurgicalProcedureCatalog")
  createdReferralLevels            ReferralLevel[]            @relation("CreatedReferralLevel")
  updatedReferralLevels            ReferralLevel[]            @relation("UpdatedReferralLevel")
  createdMedicalAptitudes          MedicalAptitude[]          @relation("CreatedMedicalAptitude")
  updatedMedicalAptitudes          MedicalAptitude[]          @relation("UpdatedMedicalAptitude")
  createdRelationshipTypes         RelationshipType[]         @relation("CreatedRelationshipType")
  updatedRelationshipTypes         RelationshipType[]         @relation("UpdatedRelationshipType")
  createdAllergyCategorys          AllergyCategory[]          @relation("CreatedAllergyCategory")
  updatedAllergyCategorys          AllergyCategory[]          @relation("UpdatedAllergyCategory")
  createdAllergenCatalogs          AllergenCatalog[]          @relation("CreatedAllergenCatalog")
  updatedAllergenCatalogs          AllergenCatalog[]          @relation("UpdatedAllergenCatalog")
  createdDiseaseTypeCatalogs       DiseaseTypeCatalog[]       @relation("CreatedDiseaseTypeCatalog")
  updatedDiseaseTypeCatalogs       DiseaseTypeCatalog[]       @relation("UpdatedDiseaseTypeCatalog")
  createdMaritalStatusCatalogs     MaritalStatusCatalog[]     @relation("CreatedMaritalStatusCatalog")
  updatedMaritalStatusCatalogs     MaritalStatusCatalog[]     @relation("UpdatedMaritalStatusCatalog")
  createdBloodTypeCatalogs         BloodTypeCatalog[]         @relation("CreatedBloodTypeCatalog")
  updatedBloodTypeCatalogs         BloodTypeCatalog[]         @relation("UpdatedBloodTypeCatalog")
  createdHabitCatalogs             HabitCatalog[]             @relation("CreatedHabitCatalog")
  updatedHabitCatalogs             HabitCatalog[]             @relation("UpdatedHabitCatalog")
  createdSuspensionHourCatalogs    SuspensionHourCatalog[]    @relation("CreatedSuspensionHourCatalog")
  updatedSuspensionHourCatalogs    SuspensionHourCatalog[]    @relation("UpdatedSuspensionHourCatalog")
  createdExerciseCatalogs          ExerciseCatalog[]          @relation("CreatedExerciseCatalog")
  updatedExerciseCatalogs          ExerciseCatalog[]          @relation("UpdatedExerciseCatalog")
  createdDocumentTypeCatalogs      DocumentTypeCatalog[]      @relation("CreatedDocumentTypeCatalog")
  updatedDocumentTypeCatalogs      DocumentTypeCatalog[]      @relation("UpdatedDocumentTypeCatalog")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?  @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String? @db.Text

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  idToken               String?   @db.Text
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

// ═══════════════════════════════════════════════════════════════════════
// CATÁLOGOS
// ═══════════════════════════════════════════════════════════════════════

model DocumentTypeCatalog {
  id     Int     @id @default(autoincrement())
  code   String  @unique // "MEDICAL_CERTIFICATE", "ILLNESS_CERTIFICATE"
  name   String
  active Boolean @default(true)

  documents Document[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedDocumentTypeCatalog", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedDocumentTypeCatalog", fields: [updatedById], references: [id])

  @@map("document_type_catalog")
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  acronym     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedCompany", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedCompany", fields: [updatedById], references: [id])

  patients Patient[]

  @@map("company")
}

model Workplace {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedWorkplace", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedWorkplace", fields: [updatedById], references: [id])

  patients Patient[]

  @@map("workplace")
}

model WorkArea {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedWorkArea", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedWorkArea", fields: [updatedById], references: [id])

  patients Patient[]

  @@map("work_area")
}

model JobPosition {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedJobPosition", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedJobPosition", fields: [updatedById], references: [id])

  patients Patient[]

  @@map("job_position")
}

model EncounterType {
  id   Int     @id @default(autoincrement())
  code String? @unique
  name String

  encounters Encounter[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedEncounterType", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedEncounterType", fields: [updatedById], references: [id])

  @@map("encounter_type")
}

model OccupationalExposure {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  entries OccupationalExposureEntry[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedOccupationalExposure", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedOccupationalExposure", fields: [updatedById], references: [id])

  @@map("occupational_exposure")
}

model WorkDisability {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  entries WorkDisabilityEntry[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedWorkDisability", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedWorkDisability", fields: [updatedById], references: [id])

  @@map("work_disability")
}

model SurgicalProcedureCatalog {
  id     Int     @id @default(autoincrement())
  code   String? @unique
  name   String
  active Boolean @default(true)

  entries SurgicalHistoryEntry[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedSurgicalProcedureCatalog", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedSurgicalProcedureCatalog", fields: [updatedById], references: [id])

  @@map("surgical_procedure_catalog")
}

model ReferralLevel {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  encounters Encounter[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedReferralLevel", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedReferralLevel", fields: [updatedById], references: [id])

  @@map("referral_level")
}

model MedicalAptitude {
  id   Int     @id @default(autoincrement())
  code String? @unique
  name String

  encounters Encounter[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedMedicalAptitude", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedMedicalAptitude", fields: [updatedById], references: [id])

  @@map("medical_aptitude")
}

model RelationshipType {
  id   Int    @id @default(autoincrement())
  name String @unique

  emergencyContacts EmergencyContact[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedRelationshipType", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedRelationshipType", fields: [updatedById], references: [id])

  @@map("relationship_type")
}

model Icd10Code {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String  @db.Text
  chapter     String?
  block       String?
  active      Boolean @default(true)

  medicalHistoryEntries MedicalHistoryEntry[]
  traumaHistoryEntries  TraumaHistoryEntry[]
  familyHistoryEntries  FamilyHistoryEntry[]
  diagnoses             Diagnosis[]

  @@index([code])
  @@fulltext([description])
  @@map("icd10_code")
}

model AllergyCategory {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  allergens AllergenCatalog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedAllergyCategory", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedAllergyCategory", fields: [updatedById], references: [id])

  @@map("allergy_category")
}

model AllergenCatalog {
  id                Int     @id @default(autoincrement())
  name              String
  allergyCategoryId Int
  active            Boolean @default(true)

  allergyCategory AllergyCategory @relation(fields: [allergyCategoryId], references: [id])
  allergies       Allergy[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedAllergenCatalog", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedAllergenCatalog", fields: [updatedById], references: [id])

  @@unique([name, allergyCategoryId])
  @@map("allergen_catalog")
}

model HabitCatalog {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  habits Habit[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedHabitCatalog", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedHabitCatalog", fields: [updatedById], references: [id])

  @@map("habit_catalog")
}

model DiseaseTypeCatalog {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  diagnoses Diagnosis[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedDiseaseTypeCatalog", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedDiseaseTypeCatalog", fields: [updatedById], references: [id])

  @@map("disease_type_catalog")
}

model MaritalStatusCatalog {
  id     Int     @id @default(autoincrement())
  name   String
  sex    Sex?
  active Boolean @default(true)

  patients Patient[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedMaritalStatusCatalog", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedMaritalStatusCatalog", fields: [updatedById], references: [id])

  @@map("marital_status_catalog")
}

model BloodTypeCatalog {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  patients Patient[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedBloodTypeCatalog", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedBloodTypeCatalog", fields: [updatedById], references: [id])

  @@map("blood_type_catalog")
}

model SuspensionHourCatalog {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  encounters Encounter[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedSuspensionHourCatalog", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedSuspensionHourCatalog", fields: [updatedById], references: [id])

  @@map("suspension_hour_catalog")
}

// ═══════════════════════════════════════════════════════════════════════
// ENTIDADES PRINCIPALES
// ═══════════════════════════════════════════════════════════════════════

model Person {
  id               Int          @id @default(autoincrement())
  givenNames       String
  familyNames      String
  documentType     DocumentType @default(DPI)
  identityDocument String       @unique
  birthDate        DateTime     @db.Date
  sex              Sex
  phone            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdById      String?
  updatedById      String?

  createdBy User? @relation("CreatedPerson", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedPerson", fields: [updatedById], references: [id])

  patient Patient?
  user    User?

  @@index([identityDocument])
  @@index([familyNames, givenNames])
  @@map("person")
}

model Patient {
  id              Int      @id @default(autoincrement())
  personId        Int      @unique
  maritalStatusId Int
  companyId       Int
  workplaceId     Int
  workAreaId      Int
  jobPositionId   Int
  bloodTypeId     Int?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?
  updatedById     String?

  createdBy User? @relation("CreatedPatient", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedPatient", fields: [updatedById], references: [id])

  person        Person               @relation(fields: [personId], references: [id], onDelete: Cascade)
  company       Company              @relation(fields: [companyId], references: [id])
  workplace     Workplace            @relation(fields: [workplaceId], references: [id])
  workArea      WorkArea             @relation(fields: [workAreaId], references: [id])
  jobPosition   JobPosition          @relation(fields: [jobPositionId], references: [id])
  maritalStatus MaritalStatusCatalog @relation(fields: [maritalStatusId], references: [id])
  bloodType     BloodTypeCatalog?    @relation(fields: [bloodTypeId], references: [id])

  emergencyContacts EmergencyContact[]
  encounters        Encounter[]
  documents         Document[]

  @@index([companyId])
  @@map("patient")
}

model EmergencyContact {
  id                 Int     @id @default(autoincrement())
  patientId          Int
  fullName           String
  phone              String
  relationshipTypeId Int
  isPrimary          Boolean @default(false)

  patient          Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  relationshipType RelationshipType @relation(fields: [relationshipTypeId], references: [id])

  @@map("emergency_contact")
}

// ═══════════════════════════════════════════════════════════════════════
// CONSULTA / ENCOUNTER (FHIR: Encounter)
// ═══════════════════════════════════════════════════════════════════════

model Encounter {
  id                      Int             @id @default(autoincrement())
  patientId               Int
  practitionerId          String
  encounterTypeId         Int
  date                    DateTime        @default(now())
  isFirstVisit            Boolean         @default(false)
  symptomatology          String?         @db.Text
  illnessHistory          String?         @db.Text
  gynecologicalHistory    String?         @db.Text
  pregnancyStatus         PregnancyStatus @default(NOT_APPLICABLE)
  sleepHours              Float?
  medicationsAdministered String?         @db.Text
  suspensionHourId        Int?
  referralLevelId         Int?
  medicalAptitudeId       Int?
  internalObservation     String?         @db.Text
  employerObservation     String?         @db.Text
  followUpDate            DateTime?       @db.Date
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @default(now()) @updatedAt
  createdById             String?
  updatedById             String?

  createdBy User? @relation("CreatedEncounter", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedEncounter", fields: [updatedById], references: [id])

  // Relaciones
  patient         Patient                @relation(fields: [patientId], references: [id])
  practitioner    User                   @relation(fields: [practitionerId], references: [id])
  encounterType   EncounterType          @relation(fields: [encounterTypeId], references: [id])
  referralLevel   ReferralLevel?         @relation(fields: [referralLevelId], references: [id])
  medicalAptitude MedicalAptitude?       @relation(fields: [medicalAptitudeId], references: [id])
  suspensionHour  SuspensionHourCatalog? @relation(fields: [suspensionHourId], references: [id])

  // Datos clínicos
  vitalSign                   VitalSign?
  anthropometry               Anthropometry?
  occupationalExposureEntries OccupationalExposureEntry[]
  workDisabilityEntries       WorkDisabilityEntry[]
  medicalHistoryEntries       MedicalHistoryEntry[]
  surgicalHistoryEntries      SurgicalHistoryEntry[]
  traumaHistoryEntries        TraumaHistoryEntry[]
  familyHistoryEntries        FamilyHistoryEntry[]
  allergies                   Allergy[]
  habits                      Habit[]
  exercises                   Exercise[]
  diagnoses                   Diagnosis[]
  documents                   Document[]

  @@index([patientId])
  @@index([date])
  @@index([practitionerId])
  @@map("encounter")
}

// ═══════════════════════════════════════════════════════════════════════
// DATOS CLÍNICOS POR ENCOUNTER
// ═══════════════════════════════════════════════════════════════════════

/// Signos vitales — FHIR: Observation (category: vital-signs)

model VitalSign {
  id               Int    @id @default(autoincrement())
  encounterId      Int    @unique
  systolicBP       Float? // PA sistólica (mmHg)
  diastolicBP      Float? // PA diastólica (mmHg)
  heartRate        Float? // FC (bpm)
  respiratoryRate  Float? // FR (/min)
  oxygenSaturation Float? // SPO2 (%)
  glucose          Float? // Glucosa (mg/dL)
  temperature      Float? // Temperatura (°C)

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("vital_sign")
}

/// Antropometría — FHIR: Observation (category: body-measurement)

model Anthropometry {
  id                     Int          @id @default(autoincrement())
  encounterId            Int          @unique
  weight                 Float? // kg
  height                 Float? // cm
  bmi                    Float? // Calculado: weight / (height/100)²
  bmiCategory            BmiCategory? // Clasificación automática OMS
  abdominalCircumference Float? // cm

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("anthropometry")
}

/// Exposición laboral por consulta

model OccupationalExposureEntry {
  id                     Int     @id @default(autoincrement())
  encounterId            Int
  occupationalExposureId Int
  observations           String? @db.Text

  encounter            Encounter            @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  occupationalExposure OccupationalExposure @relation(fields: [occupationalExposureId], references: [id])

  @@unique([encounterId, occupationalExposureId])
  @@map("occupational_exposure_entry")
}

/// Incapacidad laboral por consulta

model WorkDisabilityEntry {
  id               Int     @id @default(autoincrement())
  encounterId      Int
  workDisabilityId Int
  observations     String? @db.Text

  encounter      Encounter      @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  workDisability WorkDisability @relation(fields: [workDisabilityId], references: [id])

  @@unique([encounterId, workDisabilityId])
  @@map("work_disability_entry")
}

/// Antecedentes médicos — FHIR: Condition (category: problem-list)

model MedicalHistoryEntry {
  id           Int     @id @default(autoincrement())
  encounterId  Int
  icd10CodeId  Int
  observations String? @db.Text

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  icd10Code Icd10Code @relation(fields: [icd10CodeId], references: [id])

  @@map("medical_history_entry")
}

/// Antecedentes quirúrgicos — FHIR: Procedure

model SurgicalHistoryEntry {
  id                  Int     @id @default(autoincrement())
  encounterId         Int
  surgicalProcedureId Int
  observations        String? @db.Text

  encounter         Encounter                @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  surgicalProcedure SurgicalProcedureCatalog @relation(fields: [surgicalProcedureId], references: [id])

  @@map("surgical_history_entry")
}

/// Antecedentes traumáticos — FHIR: Condition (category: trauma)

model TraumaHistoryEntry {
  id           Int     @id @default(autoincrement())
  encounterId  Int
  icd10CodeId  Int
  observations String? @db.Text

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  icd10Code Icd10Code @relation(fields: [icd10CodeId], references: [id])

  @@map("trauma_history_entry")
}

/// Antecedentes familiares — FHIR: FamilyMemberHistory

model FamilyHistoryEntry {
  id           Int     @id @default(autoincrement())
  encounterId  Int
  icd10CodeId  Int
  observations String? @db.Text

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  icd10Code Icd10Code @relation(fields: [icd10CodeId], references: [id])

  @@map("family_history_entry")
}

/// Alergias — FHIR: AllergyIntolerance

model Allergy {
  id                Int    @id @default(autoincrement())
  encounterId       Int
  allergenCatalogId Int
  detail            String @db.Text

  encounter       Encounter       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  allergenCatalog AllergenCatalog @relation(fields: [allergenCatalogId], references: [id])

  @@map("allergy")
}

/// Hábitos

model Habit {
  id             Int             @id @default(autoincrement())
  encounterId    Int
  habitCatalogId Int
  duration       String? // hace cuánto tiempo
  quantity       Float?
  frequency      HabitFrequency?
  observations   String?         @db.Text

  encounter    Encounter    @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  habitCatalog HabitCatalog @relation(fields: [habitCatalogId], references: [id])

  @@map("habit")
}

/// Ejercicio

model ExerciseCatalog {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  exercises Exercise[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  createdBy User? @relation("CreatedExerciseCatalog", fields: [createdById], references: [id])
  updatedBy User? @relation("UpdatedExerciseCatalog", fields: [updatedById], references: [id])

  @@map("exercise_catalog")
}

model Exercise {
  id                Int     @id @default(autoincrement())
  encounterId       Int
  doesExercise      Boolean @default(false)
  exerciseCatalogId Int?
  timesPerWeek      Int?

  encounter       Encounter        @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  exerciseCatalog ExerciseCatalog? @relation(fields: [exerciseCatalogId], references: [id])

  @@map("exercise")
}

/// Diagnóstico — FHIR: Condition (category: encounter-diagnosis)

model Diagnosis {
  id            Int     @id @default(autoincrement())
  encounterId   Int
  icd10CodeId   Int
  diseaseTypeId Int?
  observations  String? @db.Text
  isPrimary     Boolean @default(false)

  encounter   Encounter           @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  icd10Code   Icd10Code           @relation(fields: [icd10CodeId], references: [id])
  diseaseType DiseaseTypeCatalog? @relation(fields: [diseaseTypeId], references: [id])

  @@map("diagnosis")
}

// ═══════════════════════════════════════════════════════════════════════
// CONSTANCIA MÉDICA — FHIR: DocumentReference
// ═══════════════════════════════════════════════════════════════════════

model Document {
  id             Int      @id @default(autoincrement())
  encounterId    Int
  patientId      Int
  documentTypeId Int
  issuedByUserId String
  issuedAt       DateTime @default(now())
  pdfUrl         String?  @db.Text

  documentType DocumentTypeCatalog @relation(fields: [documentTypeId], references: [id])
  encounter    Encounter           @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient      Patient             @relation(fields: [patientId], references: [id])
  issuedBy     User                @relation(fields: [issuedByUserId], references: [id])

  @@unique([encounterId, documentTypeId])
  @@index([patientId])
  @@index([documentTypeId])
  @@map("document")
}

// ═══════════════════════════════════════════════════════════════════════
// AUDITORÍA — FHIR: AuditEvent
// ═══════════════════════════════════════════════════════════════════════

model AuditLog {
  id           Int         @id @default(autoincrement())
  userId       String
  action       AuditAction
  entityType   String // nombre de la tabla afectada
  entityId     String // PK del registro afectado
  previousData Json? // snapshot antes del cambio
  newData      Json? // snapshot después del cambio
  ipAddress    String?
  userAgent    String?     @db.Text
  description  String?     @db.Text
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}
