// ═══════════════════════════════════════════════════════════════════════
// FM-PREMED — Schema Prisma (HL7 FHIR)
// Sistema de Fichas Médicas para Clínica Interna de Empresa
// ═══════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "mysql"
}

// ═══════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════

enum UserRole {
  ADMIN
  DOCTOR
  VIEWER
}

enum Sex {
  MALE
  FEMALE
}

enum DocumentType {
  DPI
  PASSPORT
  OTHER
}

enum PregnancyStatus {
  PREGNANT
  POSTPARTUM
  NOT_PREGNANT
  NOT_APPLICABLE
}

enum BmiCategory {
  UNDERWEIGHT
  NORMAL
  OVERWEIGHT
  OBESE_I
  OBESE_II
  OBESE_III
}

enum HabitFrequency {
  DAILY
  WEEKLY
  MONTHLY
  OCCASIONAL
  FORMER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
}

// ═══════════════════════════════════════════════════════════════════════
// AUTENTICACIÓN — better-auth
// ═══════════════════════════════════════════════════════════════════════

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?  @db.Text
  role          UserRole @default(VIEWER)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones better-auth
  sessions Session[]
  accounts Account[]

  practitioner Practitioner?

  // Relaciones del negocio
  auditLogs  AuditLog[]

  banned     Boolean?  @default(false)
  banReason  String?   @db.Text
  banExpires DateTime?

  // Relaciones de auditoría (creación/modificación)

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?  @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String? @db.Text

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  idToken               String?   @db.Text
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

// ═══════════════════════════════════════════════════════════════════════
// CATÁLOGOS
// ═══════════════════════════════════════════════════════════════════════

model DocumentTypeCatalog {
  id     Int     @id @default(autoincrement())
  code   String  @unique // "MEDICAL_CERTIFICATE", "ILLNESS_CERTIFICATE"
  name   String
  active Boolean @default(true)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  @@map("document_type_catalog")
}

enum WorkplaceType {
  OBRA
  OFICINA
  PLANTA
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  acronym   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  patients Patient[]
  workplaces Workplace[]

  @@map("company")
}

model Workplace {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  type      WorkplaceType @default(OFICINA)
  companyId Int?
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  company   Company?      @relation(fields: [companyId], references: [id])
  patients  Patient[]

  @@map("workplace")
}

model WorkArea {
  id        Int            @id @default(autoincrement())
  name      String
  type      WorkplaceType?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  patients Patient[]

  @@unique([name, type])
  @@map("work_area")
}

model JobPosition {
  id        Int            @id @default(autoincrement())
  name      String
  type      WorkplaceType?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  patients Patient[]

  @@unique([name, type])
  @@map("job_position")
}

model EncounterType {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  encounters Encounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  @@map("encounter_type")
}

model OccupationalExposure {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  entries OccupationalExposureEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  @@map("occupational_exposure")
}

model WorkDisability {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  entries WorkDisabilityEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  @@map("work_disability")
}

model SurgicalProcedureCatalog {
  id     Int     @id @default(autoincrement())
  code   String? @unique
  name   String
  active Boolean @default(true)

  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @default(now()) @updatedAt
  createdBy                String?
  updatedBy                String?
  patientSurgicalHistories PatientSurgicalHistory[]

  @@map("surgical_procedure_catalog")
}

model ReferralLevel {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  encounters Encounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  @@map("referral_level")
}

model MedicalAptitude {
  id   Int     @id @default(autoincrement())
  code String? @unique
  name String

  encounters Encounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  @@map("medical_aptitude")
}

model RelationshipType {
  id   Int    @id @default(autoincrement())
  name String @unique

  emergencyContacts EmergencyContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  @@map("relationship_type")
}

model Icd10Code {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String  @db.Text
  chapter     String?
  block       String?
  active      Boolean @default(true)

  diagnoses               Diagnosis[]
  patientMedicalHistories PatientMedicalHistory[]
  patientTraumaHistories  PatientTraumaHistory[]
  patientFamilyHistories  PatientFamilyHistory[]

  @@index([code])
  @@fulltext([description])
  @@map("icd10_code")
}

model AllergyCategory {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  allergens AllergenCatalog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  @@map("allergy_category")
}

model AllergenCatalog {
  id                Int     @id @default(autoincrement())
  name              String
  allergyCategoryId Int
  active            Boolean @default(true)

  allergyCategory AllergyCategory @relation(fields: [allergyCategoryId], references: [id])

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  createdBy        String?
  updatedBy        String?
  patientAllergies PatientAllergy[]

  @@unique([name, allergyCategoryId])
  @@map("allergen_catalog")
}

model HabitCatalog {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  createdBy     String?
  updatedBy     String?
  patientHabits PatientHabit[]

  @@map("habit_catalog")
}

model DiseaseTypeCatalog {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  diagnoses Diagnosis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  @@map("disease_type_catalog")
}

model MaritalStatusCatalog {
  id     Int     @id @default(autoincrement())
  name   String
  sex    Sex?
  active Boolean @default(true)

  patients Patient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  @@unique([name])
  @@map("marital_status_catalog")
}

model BloodTypeCatalog {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  patients Patient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  @@map("blood_type_catalog")
}

model SuspensionHourCatalog {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)

  encounters Encounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String?
  updatedBy String?

  @@map("suspension_hour_catalog")
}

// ═══════════════════════════════════════════════════════════════════════
// ENTIDADES PRINCIPALES
// ═══════════════════════════════════════════════════════════════════════

model Practitioner {
  id               Int      @id @default(autoincrement())
  userId           String   @unique
  givenNames       String
  familyNames      String
  sex              Sex
  preamble         String?  @db.Text
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?
  updatedBy        String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  encounters Encounter[]
  documents  Document[]

  @@map("practitioner")
}

model Person {
  id               Int          @id @default(autoincrement())
  givenNames       String
  familyNames      String
  documentType     DocumentType @default(DPI)
  identityDocument String       @unique
  birthDate        DateTime?    @db.Date
  sex              Sex
  phone            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        String?
  updatedBy        String?

  patient Patient?

  @@index([familyNames, givenNames])
  @@map("person")
}

model Patient {
  id              Int      @id @default(autoincrement())
  personId        Int      @unique
  maritalStatusId Int
  companyId       Int
  workplaceId     Int
  workAreaId      Int?
  jobPositionId   Int
  bloodTypeId     Int?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?

  person        Person               @relation(fields: [personId], references: [id], onDelete: Cascade)
  company       Company              @relation(fields: [companyId], references: [id])
  workplace     Workplace            @relation(fields: [workplaceId], references: [id])
  workArea      WorkArea?            @relation(fields: [workAreaId], references: [id])
  jobPosition   JobPosition          @relation(fields: [jobPositionId], references: [id])
  maritalStatus MaritalStatusCatalog @relation(fields: [maritalStatusId], references: [id])
  bloodType     BloodTypeCatalog?    @relation(fields: [bloodTypeId], references: [id])

  emergencyContacts EmergencyContact[]
  encounters        Encounter[]
  documents         Document[]

  medicalHistory  PatientMedicalHistory[]
  surgicalHistory PatientSurgicalHistory[]
  traumaHistory   PatientTraumaHistory[]
  familyHistory   PatientFamilyHistory[]
  allergies       PatientAllergy[]
  habits          PatientHabit[]
  exercises       PatientExercise[]

  @@index([companyId])
  @@map("patient")
}

model EmergencyContact {
  id                 Int     @id @default(autoincrement())
  patientId          Int
  fullName           String
  phone              String
  relationshipTypeId Int
  isPrimary          Boolean @default(false)

  patient          Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  relationshipType RelationshipType @relation(fields: [relationshipTypeId], references: [id])

  @@map("emergency_contact")
}

// ═══════════════════════════════════════════════════════════════════════
// ANTECEDENTES MÉDICOS (NIVEL PACIENTE)
// ═══════════════════════════════════════════════════════════════════════

/// Antecedentes médicos — FHIR: Condition (category: problem-list)
model PatientMedicalHistory {
  id           Int      @id @default(autoincrement())
  patientId    Int
  icd10CodeId  Int
  observations String?  @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  createdBy    String?
  updatedBy    String?

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  icd10Code Icd10Code @relation(fields: [icd10CodeId], references: [id])

  @@index([patientId])
  @@map("patient_medical_history")
}

/// Antecedentes quirúrgicos — FHIR: Procedure
model PatientSurgicalHistory {
  id                  Int      @id @default(autoincrement())
  patientId           Int
  surgicalProcedureId Int
  observations        String?  @db.Text
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  createdBy           String?
  updatedBy           String?

  patient           Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  surgicalProcedure SurgicalProcedureCatalog @relation(fields: [surgicalProcedureId], references: [id])

  @@index([patientId])
  @@map("patient_surgical_history")
}

/// Antecedentes traumáticos — FHIR: Condition (category: trauma)
model PatientTraumaHistory {
  id           Int      @id @default(autoincrement())
  patientId    Int
  icd10CodeId  Int
  observations String?  @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  createdBy    String?
  updatedBy    String?

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  icd10Code Icd10Code @relation(fields: [icd10CodeId], references: [id])

  @@index([patientId])
  @@map("patient_trauma_history")
}

/// Antecedentes familiares — FHIR: FamilyMemberHistory
model PatientFamilyHistory {
  id           Int      @id @default(autoincrement())
  patientId    Int
  icd10CodeId  Int
  observations String?  @db.Text
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  createdBy    String?
  updatedBy    String?

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  icd10Code Icd10Code @relation(fields: [icd10CodeId], references: [id])

  @@index([patientId])
  @@map("patient_family_history")
}

/// Alergias — FHIR: AllergyIntolerance
model PatientAllergy {
  id                Int      @id @default(autoincrement())
  patientId         Int
  allergenCatalogId Int
  detail            String?  @db.Text
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  createdBy         String?
  updatedBy         String?

  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergenCatalog AllergenCatalog @relation(fields: [allergenCatalogId], references: [id])

  @@index([patientId])
  @@map("patient_allergy")
}

/// Hábitos del paciente
model PatientHabit {
  id             Int             @id @default(autoincrement())
  patientId      Int
  habitCatalogId Int
  duration       String?
  quantity       Float?
  frequency      HabitFrequency?
  observations   String?         @db.Text
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  createdBy      String?
  updatedBy      String?

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  habitCatalog HabitCatalog @relation(fields: [habitCatalogId], references: [id])

  @@index([patientId])
  @@map("patient_habit")
}

/// Ejercicio del paciente
model PatientExercise {
  id                Int      @id @default(autoincrement())
  patientId         Int
  exerciseCatalogId Int
  timesPerWeek      Int?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  createdBy         String?
  updatedBy         String?

  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  exerciseCatalog ExerciseCatalog @relation(fields: [exerciseCatalogId], references: [id])

  @@index([patientId])
  @@map("patient_exercise")
}

// ═══════════════════════════════════════════════════════════════════════
// CONSULTA / ENCOUNTER (FHIR: Encounter)
// ═══════════════════════════════════════════════════════════════════════

model Encounter {
  id                      Int             @id @default(autoincrement())
  patientId               Int
  practitionerId          Int
  encounterTypeId         Int
  isFirstVisit            Boolean         @default(false)
  symptomatology          String?         @db.Text
  illnessHistory          String?         @db.Text
  gynecologicalHistory    String?         @db.Text
  pregnancyStatus         PregnancyStatus @default(NOT_APPLICABLE)
  sleepHours              Float?
  medicationsAdministered String?         @db.Text
  suspensionHourId        Int?
  referralLevelId         Int?
  medicalAptitudeId       Int?
  internalObservation     String?         @db.Text
  employerObservation     String?         @db.Text
  followUpDate            DateTime?       @db.Date
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @default(now()) @updatedAt
  createdBy               String?
  updatedBy               String?

  // Relaciones
  patient         Patient                @relation(fields: [patientId], references: [id])
  practitioner    Practitioner           @relation(fields: [practitionerId], references: [id])
  encounterType   EncounterType          @relation(fields: [encounterTypeId], references: [id])
  referralLevel   ReferralLevel?         @relation(fields: [referralLevelId], references: [id])
  medicalAptitude MedicalAptitude?       @relation(fields: [medicalAptitudeId], references: [id])
  suspensionHour  SuspensionHourCatalog? @relation(fields: [suspensionHourId], references: [id])

  // Datos clínicos
  vitalSign                   VitalSign?
  anthropometry               Anthropometry?
  occupationalExposureEntries OccupationalExposureEntry[]
  workDisabilityEntries       WorkDisabilityEntry[]
  diagnoses                   Diagnosis[]
  documents                   Document[]

  @@index([patientId])
  @@index([practitionerId])
  @@map("encounter")
}

// ═══════════════════════════════════════════════════════════════════════
// DATOS CLÍNICOS POR ENCOUNTER
// ═══════════════════════════════════════════════════════════════════════

/// Signos vitales — FHIR: Observation (category: vital-signs)

model VitalSign {
  id               Int    @id @default(autoincrement())
  encounterId      Int    @unique
  systolicBP       Float? // PA sistólica (mmHg)
  diastolicBP      Float? // PA diastólica (mmHg)
  heartRate        Float? // FC (bpm)
  respiratoryRate  Float? // FR (/min)
  oxygenSaturation Float? // SPO2 (%)
  glucose          Float? // Glucosa (mg/dL)
  temperature      Float? // Temperatura (°C)

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("vital_sign")
}

/// Antropometría — FHIR: Observation (category: body-measurement)

model Anthropometry {
  id                     Int          @id @default(autoincrement())
  encounterId            Int          @unique
  weight                 Float? // kg
  height                 Float? // cm
  bmi                    Float? // Calculado: weight / (height/100)²
  bmiCategory            BmiCategory? // Clasificación automática OMS
  abdominalCircumference Float? // cm

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@map("anthropometry")
}

/// Exposición laboral por consulta

model OccupationalExposureEntry {
  id                     Int     @id @default(autoincrement())
  encounterId            Int
  occupationalExposureId Int
  observations           String? @db.Text

  encounter            Encounter            @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  occupationalExposure OccupationalExposure @relation(fields: [occupationalExposureId], references: [id])

  @@unique([encounterId, occupationalExposureId])
  @@map("occupational_exposure_entry")
}

/// Incapacidad laboral por consulta

model WorkDisabilityEntry {
  id               Int     @id @default(autoincrement())
  encounterId      Int
  workDisabilityId Int
  observations     String? @db.Text

  encounter      Encounter      @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  workDisability WorkDisability @relation(fields: [workDisabilityId], references: [id])

  @@unique([encounterId, workDisabilityId])
  @@map("work_disability_entry")
}

/// Ejercicio

model ExerciseCatalog {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  createdBy        String?
  updatedBy        String?
  patientExercises PatientExercise[]

  @@map("exercise_catalog")
}

/// Diagnóstico — FHIR: Condition (category: encounter-diagnosis)

model Diagnosis {
  id            Int     @id @default(autoincrement())
  encounterId   Int
  icd10CodeId   Int
  diseaseTypeId Int?
  observations  String? @db.Text
  isPrimary     Boolean @default(false)

  encounter   Encounter           @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  icd10Code   Icd10Code           @relation(fields: [icd10CodeId], references: [id])
  diseaseType DiseaseTypeCatalog? @relation(fields: [diseaseTypeId], references: [id])

  @@index([encounterId])
  @@map("diagnosis")
}

// ═══════════════════════════════════════════════════════════════════════
// CONSTANCIA MÉDICA — FHIR: DocumentReference
// ═══════════════════════════════════════════════════════════════════════

model Document {
  id             Int      @id @default(autoincrement())
  encounterId    Int
  patientId      Int
  documentTypeId Int
  issuedByPractitionerId Int
  issuedAt       DateTime @default(now())
  pdfUrl         String?  @db.Text

  documentType DocumentTypeCatalog @relation(fields: [documentTypeId], references: [id])
  encounter    Encounter           @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient      Patient             @relation(fields: [patientId], references: [id])
  issuedBy     Practitioner        @relation(fields: [issuedByPractitionerId], references: [id])

  @@unique([encounterId, documentTypeId])
  @@index([patientId])
  @@index([documentTypeId])
  @@map("document")
}

// ═══════════════════════════════════════════════════════════════════════
// AUDITORÍA — FHIR: AuditEvent
// ═══════════════════════════════════════════════════════════════════════

model AuditLog {
  id           Int         @id @default(autoincrement())
  userId       String
  action       AuditAction
  entityType   String // nombre de la tabla afectada
  entityId     String // PK del registro afectado
  previousData Json? // snapshot antes del cambio
  newData      Json? // snapshot después del cambio
  ipAddress    String?
  userAgent    String?     @db.Text
  description  String?     @db.Text
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}
